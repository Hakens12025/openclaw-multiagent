{
  "meta": {
    "lastTouchedVersion": "example"
  },
  "wizard": {
    "lastRunMode": "local"
  },
  "browser": {
    "enabled": false,
    "headless": false,
    "defaultProfile": "openclaw"
  },
  "models": {
    "mode": "merge",
    "providers": {
      "kimi": {
        "baseUrl": "https://api.kimi.com/coding/v1",
        "apiKey": "YOUR_KIMI_API_KEY_HERE",
        "api": "openai-completions",
        "models": [
          { "id": "kimi-for-coding", "name": "Kimi for Coding" },
          { "id": "k3", "name": "Kimi K3" }
        ]
      },
      "glm-bigmodel": {
        "baseUrl": "https://open.bigmodel.cn/api/coding/paas/v4",
        "apiKey": "YOUR_GLM_API_KEY_HERE",
        "api": "openai-completions",
        "models": [
          { "id": "glm-5.1", "name": "GLM-5.1 (BigModel)" }
        ]
      },
      "ark-openai": {
        "baseUrl": "https://ark.cn-beijing.volces.com/api/coding/v3",
        "apiKey": "YOUR_ARK_API_KEY_HERE",
        "api": "openai-completions",
        "models": [
          { "id": "kimi-k2.5", "name": "Kimi K2.5 (ARK)" },
          { "id": "glm-4.7", "name": "GLM-4.7 (ARK)" },
          { "id": "deepseek-v3.2", "name": "DeepSeek V3.2 (ARK)" }
        ]
      },
      "ollama": {
        "baseUrl": "http://localhost:11434",
        "apiKey": "REDACTED_FOR_PUBLIC",
        "api": "ollama",
        "models": [
          { "id": "qwen3:8b", "name": "Qwen3 8B (local)" }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "glm-bigmodel/glm-5.1",
        "fallbacks": [
          "kimi/kimi-for-coding",
          "ark-openai/kimi-k2.5"
        ]
      },
      "memorySearch": { "enabled": false },
      "compaction": {
        "mode": "safeguard",
        "memoryFlush": { "enabled": false }
      },
      "timeoutSeconds": 1800,
      "typingIntervalSeconds": 6,
      "typingMode": "thinking",
      "heartbeat": { "every": "30m", "lightContext": true },
      "skipBootstrap": true,
      "maxConcurrent": 6,
      "subagents": { "maxConcurrent": 8, "runTimeoutSeconds": 1800 }
    },
    "list": [
      {
        "id": "controller",
        "role": "bridge",
        "workspace": "~/.openclaw/workspaces/controller",
        "heartbeat": { "every": "2h" },
        "skills": ["platform-map", "platform-tools", "error-avoidance", "system-action"],
        "binding": {
          "skills": {
            "configured": ["platform-map", "platform-tools", "error-avoidance", "system-action"]
          }
        },
        "tools": {
          "allow": ["read", "write", "edit", "assign_task", "ls", "grep", "search_knowledge", "submit_output"]
        },
        "gateway": true,
        "protected": true,
        "ingressSource": "webui"
      },
      {
        "id": "operator",
        "role": "agent",
        "workspace": "~/.openclaw/workspaces/operator",
        "heartbeat": { "every": "2h" },
        "skills": ["platform-map", "platform-tools", "error-avoidance", "system-action"],
        "binding": {
          "skills": {
            "configured": ["platform-map", "platform-tools", "error-avoidance", "system-action"]
          }
        },
        "tools": {
          "allow": ["read", "write", "edit", "ls", "grep", "search_knowledge", "submit_output"]
        },
        "protected": true
      },
      {
        "id": "viz-master",
        "role": "agent",
        "workspace": "~/.openclaw/workspaces/viz-master",
        "heartbeat": { "every": "2h" },
        "skills": ["platform-map", "platform-tools", "error-avoidance", "system-action", "chart-build"],
        "binding": {
          "skills": {
            "configured": ["chart-build", "platform-tools", "error-avoidance", "system-action"]
          }
        },
        "tools": {
          "allow": ["read", "write", "edit", "ls", "grep", "search_knowledge", "submit_output"]
        },
        "protected": true
      },
      {
        "id": "worker",
        "role": "executor",
        "workspace": "~/.openclaw/workspaces/worker",
        "skills": ["platform-map", "platform-tools", "error-avoidance", "system-action"],
        "binding": {
          "skills": {
            "configured": ["platform-map", "platform-tools", "error-avoidance", "system-action"]
          }
        },
        "tools": {
          "allow": ["read", "write", "edit", "web_search", "web_fetch", "ls", "grep", "search_knowledge", "submit_output"]
        }
      },
      {
        "id": "planner",
        "role": "planner",
        "workspace": "~/.openclaw/workspaces/planner",
        "skills": ["platform-map", "platform-tools", "error-avoidance", "system-action"],
        "binding": {
          "skills": {
            "configured": ["platform-map", "platform-tools", "error-avoidance", "system-action"]
          }
        },
        "tools": {
          "allow": ["read", "write", "edit", "assign_task", "ls", "grep", "search_knowledge", "submit_output"]
        }
      },
      {
        "id": "worker2",
        "role": "executor",
        "workspace": "~/.openclaw/workspaces/worker2",
        "skills": ["platform-map", "platform-tools", "error-avoidance", "system-action"],
        "binding": {
          "skills": {
            "configured": ["platform-map", "platform-tools", "error-avoidance", "system-action"]
          }
        },
        "tools": {
          "allow": ["read", "write", "edit", "web_search", "web_fetch", "ls", "grep", "search_knowledge", "submit_output"]
        }
      }
    ]
  },
  "tools": {
    "web": {
      "search": { "enabled": true, "maxResults": 10 },
      "fetch": { "enabled": true, "maxCharsCap": 50000 }
    },
    "sessions": { "visibility": "all" },
    "agentToAgent": { "enabled": true }
  },
  "bindings": [
    { "agentId": "controller", "match": { "channel": "qqbot" } },
    { "agentId": "controller", "match": { "channel": "feishu" } }
  ],
  "messages": { "ackReactionScope": "group-mentions" },
  "commands": {
    "native": "auto",
    "nativeSkills": "auto",
    "restart": true,
    "ownerDisplay": "raw"
  },
  "session": {
    "dmScope": "main",
    "resetTriggers": ["/new", "/reset"],
    "mainKey": "main"
  },
  "cron": { "maxConcurrentRuns": 4 },
  "hooks": {
    "enabled": true,
    "token": "YOUR_HOOK_TOKEN_HERE",
    "allowRequestSessionKey": true,
    "allowedSessionKeyPrefixes": ["hook:", "agent:"]
  },
  "channels": {
    "qqbot": {
      "enabled": false,
      "appId": "YOUR_QQ_APP_ID",
      "clientSecret": "YOUR_QQ_CLIENT_SECRET"
    },
    "feishu": {
      "enabled": false,
      "appId": "YOUR_FEISHU_APP_ID",
      "appSecret": "YOUR_FEISHU_APP_SECRET"
    }
  },
  "gateway": {
    "port": 18789,
    "mode": "local",
    "controlUi": { "basePath": "/ui" },
    "auth": {
      "mode": "token",
      "token": "CHANGE_ME_RUN_INIT"
    }
  },
  "plugins": {
    "entries": {
      "qqbot": { "enabled": false },
      "watchdog": { "enabled": true },
      "feishu": { "enabled": false }
    }
  }
}
