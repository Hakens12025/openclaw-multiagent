# OpenClaw Deployment Profile — 个人部署特性全部在此显式声明,产品默认路径零依赖。
# openclawctl start 读取本文件组装网关 env(纯解析不 source);删掉某行即关闭该特性。
OPENCLAW_GATEWAY_PORT=18789

# LLM 出站代理(本机 Clash Verge mixed-port;2026-08-07 核实的 live 真相,勿改回 8080——
# 8080 是 QQ 入站 SSH 隧道口不是 LLM 出站口)。NO_PROXY 含直连厂商域,localhost 地板由 ctl 恒加。
OPENCLAW_HTTPS_PROXY=http://127.0.0.1:7897
NO_PROXY=open.feishu.cn,.feishu.cn,open.larksuite.com,.larksuite.com,.volces.com,ark.cn-beijing.volces.com

# QQ 入站 SSH 反向隧道(可选,QQ 渠道专用)
OPENCLAW_PROXY_PORT=8080
OPENCLAW_SSH_REMOTE_HOST=REDACTED_FOR_PUBLIC
OPENCLAW_SSH_REMOTE_USER=root
OPENCLAW_SSH_REMOTE_PORT=18791
