{
  "name": "openclaw-multi-agent-system",
  "version": "1.0.0",
  "description": "OpenClaw 多 Agent 协作编排插件:传送带 dispatch + agent graph,以及 CLI-system(手)/operator(脑)/automation(目标)自治链(harness 判定账已于 v226 全退役)。LLM 管内容,代码管流程。",
  "type": "module",
  "main": "index.js",
  "openclaw": {
    "extensions": [
      "./index.js"
    ]
  },
  "files": [
    "index.js",
    "lib/",
    "hooks/",
    "routes/",
    "ui/",
    "test-runner.js",
    "openclaw.plugin.json",
    "README.md"
  ],
  "scripts": {
    "test": "node --test --experimental-test-module-mocks --test-concurrency=1 --test-timeout=30000 tests/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "openclaw": "*"
  },
  "license": "MIT"
}
