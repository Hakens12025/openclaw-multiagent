{
  "name": "openclaw-multi-agent-system",
  "version": "1.0.0",
  "description": "OpenClaw 多 Agent 协作编排插件:传送带 dispatch + graph-backed loop,以及 harness(工具)/CLI-system(手)/operator(脑)/automation(目标)四关节自治链。LLM 管内容,代码管流程。",
  "type": "module",
  "main": "index.js",
  "openclaw": {
    "extensions": [
      "./index.js"
    ]
  },
  "files": [
    "index.js",
    "runtime-mailbox.js",
    "protocol-registry.js",
    "lib/",
    "hooks/",
    "routes/",
    "dashboard-*.js",
    "dashboard-*.css",
    "*.css",
    "*.html",
    "test-runner.js",
    "openclaw.plugin.json",
    "README.md",
    "AGENTS.md",
    "SOUL.md"
  ],
  "scripts": {
    "test": "node --test --experimental-test-module-mocks --test-concurrency=1 --test-timeout=30000 tests/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "openclaw": "*"
  },
  "license": "MIT"
}
